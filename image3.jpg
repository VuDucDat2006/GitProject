<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 500" width="1200" height="500">
  <defs>
    <linearGradient id="slide3Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141e30"/>
      <stop offset="100%" stop-color="#243b55"/>
    </linearGradient>
    <linearGradient id="purpleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8e2de2"/>
      <stop offset="100%" stop-color="#4a00e0"/>
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="500" fill="url(#slide3Grad)"/>
  <!-- Decorative Shapes -->
  <polygon points="100,50 300,10 250,220 50,180" fill="url(#purpleGrad)" opacity="0.2"/>
  <circle cx="1000" cy="250" r="160" fill="url(#purpleGrad)" opacity="0.3"/>
  <circle cx="1100" cy="120" r="80" fill="#00e676" opacity="0.2"/>
  <!-- Icon Center -->
  <circle cx="600" cy="180" r="60" fill="url(#purpleGrad)" opacity="0.95"/>
  <path d="M580 180 L620 180 M600 160 L600 200" stroke="#ffffff" stroke-width="8" stroke-linecap="round"/>
  <!-- Text -->
  <text x="600" y="290" font-family="'Segoe UI', Roboto, sans-serif" font-size="38" font-weight="bold" fill="#ffffff" text-anchor="middle">
    Bootstrap 5 Grid System &amp; Flexbox
  </text>
  <text x="600" y="335" font-family="'Segoe UI', Roboto, sans-serif" font-size="20" fill="#b0bec5" text-anchor="middle">
    Bố cục 3 cột linh hoạt, tối ưu Display Property &amp; Spacing Utilities
  </text>
</svg>
