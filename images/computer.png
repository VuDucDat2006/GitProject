<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 292 228" width="292" height="228">
  <defs>
    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3c72"/>
      <stop offset="100%" stop-color="#2a5298"/>
    </linearGradient>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e0e0e0"/>
      <stop offset="100%" stop-color="#b0bec5"/>
    </linearGradient>
  </defs>
  <!-- Background subtle glow -->
  <rect width="292" height="228" rx="12" fill="#f8fafc"/>
  <!-- Laptop Screen Lid -->
  <rect x="56" y="30" width="180" height="115" rx="8" fill="#37474f"/>
  <rect x="66" y="38" width="160" height="95" rx="4" fill="url(#screenGrad)"/>
  <!-- Screen Content / App UI mockup -->
  <circle cx="80" cy="48" r="3" fill="#ff5252"/>
  <circle cx="90" cy="48" r="3" fill="#ffeb3b"/>
  <circle cx="100" cy="48" r="3" fill="#69f0ae"/>
  <rect x="80" y="60" width="60" height="18" rx="2" fill="#ffffff" opacity="0.8"/>
  <rect x="80" y="85" width="130" height="8" rx="2" fill="#ffffff" opacity="0.4"/>
  <rect x="80" y="100" width="100" height="8" rx="2" fill="#ffffff" opacity="0.4"/>
  <circle cx="180" cy="70" r="16" fill="#00e676" opacity="0.7"/>
  <!-- Camera dot -->
  <circle cx="146" cy="34" r="2" fill="#ffffff" opacity="0.6"/>
  <!-- Laptop Base -->
  <path d="M30 148 L262 148 L246 168 L46 168 Z" fill="url(#bodyGrad)"/>
  <!-- Touchpad notch -->
  <rect x="126" y="150" width="40" height="4" rx="2" fill="#78909c"/>
</svg>
