<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
  <defs>
    <linearGradient id="titaniumGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#9a9590"/>
      <stop offset="50%" stop-color="#69645f"/>
      <stop offset="100%" stop-color="#4d4945"/>
    </linearGradient>
    <linearGradient id="screenWallpaper" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c1917"/>
      <stop offset="50%" stop-color="#292524"/>
      <stop offset="100%" stop-color="#0c0a09"/>
    </linearGradient>
    <radialGradient id="lensGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Ambient Shadow -->
  <ellipse cx="300" cy="660" rx="200" ry="25" fill="#000000" opacity="0.6" filter="blur(10px)"/>

  <!-- Phone Titanium Body Frame -->
  <rect x="150" y="40" width="300" height="600" rx="55" fill="url(#titaniumGrad)" stroke="#b8b2ab" stroke-width="3"/>

  <!-- Inner Bezel (Ultra-thin border) -->
  <rect x="156" y="46" width="288" height="588" rx="50" fill="#000000"/>

  <!-- OLED Screen Display -->
  <rect x="160" y="50" width="280" height="580" rx="46" fill="url(#screenWallpaper)"/>

  <!-- Dynamic Island Notch -->
  <rect x="250" y="65" width="100" height="28" rx="14" fill="#000000"/>
  <circle cx="330" cy="79" r="6" fill="#1e293b"/>
  <circle cx="330" cy="79" r="2.5" fill="#0284c7"/>

  <!-- Screen Content: Glowing Apple Intelligence Ring -->
  <circle cx="300" cy="340" r="90" fill="none" stroke="#f59e0b" stroke-width="4" opacity="0.8" stroke-dasharray="10 15"/>
  <circle cx="300" cy="340" r="105" fill="none" stroke="#ec4899" stroke-width="3" opacity="0.7"/>
  <circle cx="300" cy="340" r="120" fill="none" stroke="#8b5cf6" stroke-width="2" opacity="0.5"/>
  <circle cx="300" cy="340" r="70" fill="url(#lensGlow)"/>

  <!-- Lock screen Typography -->
  <text x="300" y="160" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="44" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="-1">09:41</text>
  <text x="300" y="195" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="14" font-weight="500" fill="#94a3b8" text-anchor="middle">Thứ Ba, 13 tháng 10</text>

  <!-- Siri / Apple Intelligence Text -->
  <text x="300" y="348" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="1">APPLE INTELLIGENCE</text>

  <!-- Bottom Home Bar -->
  <rect x="235" y="615" width="130" height="5" rx="2.5" fill="#ffffff" opacity="0.8"/>
</svg>
