<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 500" width="1200" height="500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f2027"/>
      <stop offset="50%" stop-color="#203a43"/>
      <stop offset="100%" stop-color="#2c5364"/>
    </linearGradient>
    <linearGradient id="circleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00c6ff"/>
      <stop offset="100%" stop-color="#0072ff"/>
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="500" fill="url(#bgGrad)"/>
  <!-- Decorative Circles & Shapes -->
  <circle cx="1050" cy="120" r="180" fill="url(#circleGrad)" opacity="0.25"/>
  <circle cx="950" cy="380" r="120" fill="#00c6ff" opacity="0.15"/>
  <circle cx="150" cy="450" r="140" fill="#0072ff" opacity="0.2"/>
  <!-- Grid Lines -->
  <line x1="0" y1="250" x2="1200" y2="250" stroke="#ffffff" stroke-opacity="0.05" stroke-width="1"/>
  <line x1="600" y1="0" x2="600" y2="500" stroke="#ffffff" stroke-opacity="0.05" stroke-width="1"/>
  <!-- Center Graphic Icon -->
  <circle cx="600" cy="180" r="60" fill="url(#circleGrad)" opacity="0.9"/>
  <path d="M575 180 L592 197 L625 165" stroke="#ffffff" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Text Elements -->
  <text x="600" y="290" font-family="'Segoe UI', Roboto, sans-serif" font-size="38" font-weight="bold" fill="#ffffff" text-anchor="middle">
    Khám Phá Sức Mạnh Công Nghệ Mới
  </text>
  <text x="600" y="335" font-family="'Segoe UI', Roboto, sans-serif" font-size="20" fill="#b0bec5" text-anchor="middle">
    Trải nghiệm giao diện đa nền tảng tối ưu cùng Bootstrap 5 &amp; Font Awesome
  </text>
</svg>
